.*.py
**/.drafts/
x_old/
binned_output/
**/binned_output/

# --- tests: the small fixture files are tracked despite *.nc above ---
!tests/fixtures/**/*.nc
.pytest_cache/

# --- this machine's data locations (copy config/local.example.yaml) ---
config/local.yaml

# --- packaging build output ---
*.egg-info/
build/
dist/
